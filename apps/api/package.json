{
  "name": "@mosaec/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@mosaec/config": "workspace:*",
    "@mosaec/db": "workspace:*",
    "@mosaec/domain": "workspace:*",
    "@mosaec/sdk": "workspace:*",
    "@near-js/accounts": "^2.5.1",
    "@near-js/crypto": "^2.5.1",
    "@near-js/providers": "^2.5.1",
    "@near-js/signers": "^2.5.1",
    "@near-js/transactions": "^2.5.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
