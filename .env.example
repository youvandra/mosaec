# Copy to .env and fill in. Services fail at boot when a required value is missing or invalid.

# Shared by every service.
# One of: local, staging, production.
MOSAEC_ENV=local
# NEAR JSON-RPC endpoint. Local runs use the sandbox RPC.
NEAR_RPC_URL=http://127.0.0.1:3030

# API (apps/api) and indexer (apps/indexer).
# Postgres 16 connection string.
DATABASE_URL=postgres://mosaec@127.0.0.1:5432/mosaec_local

# API (apps/api).
# Port the HTTP server listens on.
API_PORT=8787
# Optional. 1Click partner JWT. Lives only in the server secret store; never commit a value.
# ONECLICK_PARTNER_JWT=
