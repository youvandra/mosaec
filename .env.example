# Copy to .env and fill in. Services fail at boot when a required value is missing or invalid.

# Shared by every service.
# One of: local, staging, production.
MOSAEC_ENV=local
# NEAR JSON-RPC endpoint. Local runs use the sandbox RPC.
NEAR_RPC_URL=http://127.0.0.1:3030

# API (apps/api) and indexer (apps/indexer).
# Postgres 16 connection string.
DATABASE_URL=postgres://mosaec@127.0.0.1:5432/mosaec_local

# API (apps/api).
# Port the HTTP server listens on.
API_PORT=8787
# Optional. 1Click partner JWT. Lives only in the server secret store; never commit a value.
# ONECLICK_PARTNER_JWT=

# Web (apps/web). Every value is optional; the feature stays off when it is empty.
# API origin the /api rewrite forwards to.
# MOSAEC_API_URL=https://api.mosaec.finance
# Sentry DSN for browser and server error reports (account names are scrubbed before sending).
# NEXT_PUBLIC_SENTRY_DSN=
# Self-hosted Umami origin and website id for cookie-free page views and funnel steps.
# NEXT_PUBLIC_UMAMI_URL=https://stats.mosaec.finance
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
